{
  "name": "vibeanimate",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "live": "bash scripts/live-render/run.sh",
    "live:bench": ".venv-live/bin/python scripts/live-render/bench.py",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "shot": "node scripts/shot.mjs",
    "thumbs": "node scripts/thumbs.mjs",
    "eval": "node scripts/eval.mjs",
    "render:act": "node scripts/render-act.mjs",
    "render:full": "node scripts/render-act.mjs FullVideo --out out/renders/FullVideo.mp4",
    "render:fast": "node scripts/render-fast.mjs",
    "render:spot": "node scripts/render-fast.mjs --scale 0.3 --fps 12 --out out/renders/spotcheck.mp4",
    "render:blender": "node blender/render.mjs",
    "preview:film": "node scripts/preview-film.mjs",
    "doctor": "node scripts/doctor.mjs",
    "test": "vitest run",
    "remotion:studio": "remotion studio src/remotion/index.ts",
    "remotion:render": "remotion render src/remotion/index.ts ZoomThrough out/zoom.mp4 --gl=angle --concurrency=1 --timeout=120000",
    "remotion:render:gpu": "remotion render src/remotion/index.ts ZoomThrough out/zoom.mp4 --gl=angle-egl --concurrency=1 --timeout=120000",
    "remotion:render720": "remotion render src/remotion/index.ts ZoomThrough720p out/zoom_720p.mp4 --gl=angle --concurrency=1 --timeout=120000",
    "remotion:render720:gpu": "remotion render src/remotion/index.ts ZoomThrough720p out/zoom_720p.mp4 --gl=angle-egl --concurrency=1 --timeout=120000",
    "parity": "node scripts/parity.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@react-three/postprocessing": "^3.0.4",
    "@remotion/cli": "4.0.286",
    "@remotion/renderer": "4.0.286",
    "@remotion/three": "4.0.286",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "remotion": "4.0.286",
    "three": "^0.183.2",
    "three-stdlib": "^2.36.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "node-pty": "^1.1.0",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vitest": "^4.1.10",
    "ws": "^8.21.3"
  },
  "description": "Code-first 3D animation & video studio: scenes as code, a visual Scenebuilder editor, shared worlds and ingredients, anime toon shading, and dual Three.js/Remotion + Blender render backends.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/openwonderful/VibeAnimate"
  }
}
